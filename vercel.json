{
  "functions": {
    "api/story.ts": {
      "maxDuration": 180,
      "includeFiles": "node_modules/{@sparticuz/chromium/bin/**,mediainfo.js/dist/MediaInfoModule.wasm,ffmpeg-static/ffmpeg}"
    },
    "api/image.ts": {
      "includeFiles": "assets/style-reference/{yadam/sent,golden}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/sync-health",
      "destination": "https://tracker-api-continuity-production.up.railway.app/api/sync-health"
    },
    {
      "source": "/api/sync/:path*",
      "destination": "https://tracker-api-continuity-production.up.railway.app/api/sync/:path*"
    }
  ]
}
